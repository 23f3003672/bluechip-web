# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site
NEXT_PUBLIC_SITE_URL=https://bluechipengineering.com

# Maintenance Mode (Set to "true" to lock frontend & admin, "false" to make live)
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=bluechip-preview-secret
