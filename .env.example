# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=your-maintenance-bypass-secret

# Resend Email Notifications
# Sign up at https://resend.com and paste your API key here (e.g. re_xxxxxxx)
RESEND_API_KEY=
# Recipient email where all inquiries and applications will be sent
NOTIFICATION_RECIPIENT_EMAIL=info@bluechiptechno.com
# From address:
# - For testing before domain verification: "Bluechip Website <onboarding@resend.dev>"
# - For production once bluechiptechno.com is verified on Resend: "Bluechip Technologies <notifications@bluechiptechno.com>"
RESEND_FROM_EMAIL="Bluechip Website <onboarding@resend.dev>"
